FROM php:8.5-zts

# Pin parallel below if a future PECL release stops building on php:8.5-zts.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        libzip-dev \
        unzip \
    && docker-php-ext-install pdo_mysql sockets zip \
    && pecl install parallel \
    && docker-php-ext-enable parallel \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2.9.7 /usr/bin/composer /usr/bin/composer

WORKDIR /app
