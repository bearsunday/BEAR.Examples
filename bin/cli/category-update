#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace MyVendor\Cms\Resource\App;

require dirname(__DIR__, 2) . '/vendor/autoload.php';

use BEAR\Resource\ResourceInterface;
use MyVendor\Cms\Injector;
use BEAR\Cli\Config;
use BEAR\Cli\ResourceCommand;

$resource = Injector::getInstance('cli-hal-api-app')->getInstance(ResourceInterface::class);
$config = new Config('app://self/category', new \ReflectionMethod(\MyVendor\Cms\Resource\App\Category::class, 'onPut'));
$command = new ResourceCommand($config, $resource);
$result = $command($argv);

echo $result->message . PHP_EOL;
exit($result->exitCode);
