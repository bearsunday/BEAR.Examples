{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/bear-cms/author",
  "title": "Author",
  "description": "ALPS Author state",
  "type": "object",
  "required": [
    "id",
    "name",
    "email"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Primary key",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "description": "Full name",
      "minLength": 4,
      "maxLength": 50
    },
    "email": {
      "type": "string",
      "description": "Email address",
      "minLength": 20,
      "maxLength": 50,
      "format": "email"
    },
    "bio": {
      "type": "string",
      "description": "Optional biography; empty allowed",
      "minLength": 0,
      "maxLength": 50
    },
    "_links": {
      "type": "object",
      "properties": {
        "self": {
          "$ref": "#/$defs/link"
        },
        "goArticleList": {
          "$ref": "#/$defs/link"
        },
        "doUpdateAuthor": {
          "$ref": "#/$defs/link"
        }
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "type": "string",
          "format": "uri-reference"
        }
      }
    }
  }
}
