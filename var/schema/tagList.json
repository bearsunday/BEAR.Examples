{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/bear-cms/tagList",
  "title": "TagList",
  "description": "List of tags",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "https://example.com/bear-cms/tag"
      }
    },
    "totalCount": {
      "type": "integer",
      "minimum": 0
    },
    "_links": {
      "type": "object",
      "properties": {
        "self": {
          "$ref": "#/$defs/link"
        },
        "goTag": {
          "$ref": "#/$defs/link"
        },
        "doCreateTag": {
          "$ref": "#/$defs/link"
        }
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "required": [
        "href"
      ],
      "properties": {
        "href": {
          "type": "string",
          "format": "uri-reference"
        }
      }
    }
  }
}
