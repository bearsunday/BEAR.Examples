{
  "$schema": "https://alps-io.github.io/schemas/alps.json",
  "alps": {
    "title": "BEAR.Cms Reference CMS",
    "doc": {
      "value": "ALPS profile for a BEAR.Sunday reference CMS. App-resource only (no admin/UI). Covers articles, categories, tags, authors and media with read and write transitions."
    },
    "descriptor": [
      {
        "id": "articleId",
        "title": "Article ID",
        "def": "https://schema.org/identifier"
      },
      {
        "id": "articleSlug",
        "title": "Article Slug",
        "doc": {
          "value": "URL-safe unique identifier used in human-readable URIs."
        }
      },
      {
        "id": "articleTitle",
        "title": "Article Title",
        "def": "https://schema.org/headline"
      },
      {
        "id": "articleBody",
        "title": "Article Body",
        "def": "https://schema.org/articleBody"
      },
      {
        "id": "articleExcerpt",
        "title": "Article Excerpt",
        "doc": {
          "value": "Short summary used in list views."
        }
      },
      {
        "id": "articleStatus",
        "title": "Article Status",
        "doc": {
          "value": "Lifecycle status: draft or published."
        }
      },
      {
        "id": "articlePublishedAt",
        "title": "Article Published At",
        "def": "https://schema.org/datePublished"
      },
      {
        "id": "categoryId",
        "title": "Category ID",
        "def": "https://schema.org/identifier"
      },
      {
        "id": "categorySlug",
        "title": "Category Slug"
      },
      {
        "id": "categoryName",
        "title": "Category Name",
        "def": "https://schema.org/name"
      },
      {
        "id": "categoryDescription",
        "title": "Category Description",
        "def": "https://schema.org/description"
      },
      {
        "id": "categoryParentId",
        "title": "Parent Category ID",
        "doc": {
          "value": "Nullable reference for hierarchical categories."
        }
      },
      {
        "id": "tagId",
        "title": "Tag ID",
        "def": "https://schema.org/identifier"
      },
      {
        "id": "tagSlug",
        "title": "Tag Slug"
      },
      {
        "id": "tagName",
        "title": "Tag Name",
        "def": "https://schema.org/name"
      },
      {
        "id": "authorId",
        "title": "Author ID",
        "def": "https://schema.org/identifier"
      },
      {
        "id": "authorName",
        "title": "Author Name",
        "def": "https://schema.org/name"
      },
      {
        "id": "authorEmail",
        "title": "Author Email",
        "def": "https://schema.org/email"
      },
      {
        "id": "authorBio",
        "title": "Author Biography",
        "def": "https://schema.org/description"
      },
      {
        "id": "mediaId",
        "title": "Media ID",
        "def": "https://schema.org/identifier"
      },
      {
        "id": "mediaFilename",
        "title": "Media Filename"
      },
      {
        "id": "mediaMimeType",
        "title": "Media MIME Type",
        "def": "https://schema.org/encodingFormat"
      },
      {
        "id": "mediaUrl",
        "title": "Media URL",
        "def": "https://schema.org/contentUrl"
      },
      {
        "id": "mediaAlt",
        "title": "Media Alt Text",
        "doc": {
          "value": "Accessibility text describing the media."
        }
      },
      {
        "id": "mediaWidth",
        "title": "Media Width",
        "def": "https://schema.org/width"
      },
      {
        "id": "mediaHeight",
        "title": "Media Height",
        "def": "https://schema.org/height"
      },
      {
        "id": "page",
        "title": "Page Number",
        "doc": {
          "value": "1-indexed pagination page."
        }
      },
      {
        "id": "perPage",
        "title": "Per-Page Count",
        "doc": {
          "value": "Number of items per page."
        }
      },
      {
        "id": "totalCount",
        "title": "Total Count",
        "doc": {
          "value": "Total matching items across all pages."
        }
      },
      {
