        "title": "CMS Entry Point",
        "descriptor": [
          {
            "href": "#goArticleList"
          },
          {
            "href": "#goCategoryList"
          },
          {
            "href": "#goTagList"
          }
        ],
        "tag": "flow-browse"
      },
      {
        "id": "Article",
        "title": "Article Detail",
        "doc": {
