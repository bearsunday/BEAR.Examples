        "id": "goArticleList",
        "type": "safe",
        "rt": "#ArticleList",
        "title": "View Article List",
        "doc": {
          "value": "List published articles, filterable by category, tag or status."
        },
        "tag": "article flow-browse",
        "descriptor": [
