          {
            "href": "#goCategory"
          },
          {
            "href": "#doUpdateArticle"
          },
          {
            "href": "#doDeleteArticle"
          }
        ],
        "tag": "article"
      },
      {
        "id": "ArticleList",
        "title": "Article List",
        "doc": {
          "value": "Paginated list of articles; supports filtering by category, tag, or status."
        },
        "descriptor": [
          {
            "href": "#articleId"
          },
          {
            "href": "#articleSlug"
          },
          {
            "href": "#articleTitle"
          },
          {
            "href": "#articleExcerpt"
          },
          {
            "href": "#articleStatus"
          },
          {
            "href": "#articlePublishedAt"
          },
          {
            "href": "#page"
          },
          {
            "href": "#perPage"
          },
          {
            "href": "#totalCount"
          },
          {
            "href": "#goArticle"
          },
          {
            "href": "#doCreateArticle"
          }
