{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "author.json",
  "title": "Author",
  "description": "ALPS Author state",
  "type": "object",
  "required": [
    "id",
    "name",
    "email"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Primary key",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "description": "Full name",
      "minLength": 4,
      "maxLength": 50
    },
    "email": {
      "type": "string",
      "description": "Email address",
      "minLength": 20,
      "maxLength": 50,
      "format": "email"
    },
    "bio": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional biography; empty allowed",
      "minLength": 0,
      "maxLength": 50
    }
  }
}
