{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/bear-cms/authResponse",
  "title": "AuthResponse",
  "description": "POST /auth response. `id` is a backward-compatible alias for `subject`; provider + subject are the stable external identity key. Failure path returns {message, reason}.",
  "type": "object",
  "properties": {
    "id":       {"type": "string"},
    "provider": {"type": "string", "enum": ["google", "auth0"]},
    "subject":  {"type": "string"},
    "email":    {"type": "string", "format": "email"},
    "name":     {"type": "string"},
    "message":  {"type": "string"},
    "reason":   {"type": "string"}
  }
}
