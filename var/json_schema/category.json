{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "category.json",
  "title": "Category",
  "description": "ALPS Category state",
  "type": "object",
  "required": [
    "id",
    "slug",
    "name"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Primary key",
      "minimum": 1
    },
    "slug": {
      "type": "string",
      "description": "URL-safe unique slug",
      "minLength": 2,
      "maxLength": 50,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "description": "Display name",
      "minLength": 2,
      "maxLength": 50
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional description",
      "minLength": 0,
      "maxLength": 100
    },
    "parentId": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Parent category id, null for top-level",
      "minimum": 1
    }
  }
}
