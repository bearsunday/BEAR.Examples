# Copy to .env for local development. Values consumed by src/Module/AppModule.php.
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=bear_cms;charset=utf8mb4
DB_USER=root
DB_PASSWORD=

# Google OAuth (production AuthInterface binding). Empty values are fine
# in dev / fake-hal-api-app context — those use FakeAuthProvider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
