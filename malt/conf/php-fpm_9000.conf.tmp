[global]
daemonize = no
error_log = "/Users/akihito/git/BEAR.Cms/malt/logs/php-fpm_9000.log"

[www]
listen = 127.0.0.1:9000
pm = dynamic
pm.max_children = 20
pm.start_servers = 5
pm.min_spare_servers = 3
pm.max_spare_servers = 7
access.log = "/Users/akihito/git/BEAR.Cms/malt/logs/php-fpm-access_9000.log"
slowlog = "/Users/akihito/git/BEAR.Cms/malt/logs/php-fpm-slow_9000.log"