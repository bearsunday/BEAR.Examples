server {
  listen 8080;
  server_name localhost;
  root "/Users/akihito/git/BEAR.Cms/public";
  index index.php index.html index.htm;

  access_log "/Users/akihito/git/BEAR.Cms/malt/logs/nginx_8080_access.log";
  error_log "/Users/akihito/git/BEAR.Cms/malt/logs/nginx_8080_error.log";

  location / {
    try_files $uri $uri/ /index.php?$query_string;
  }

  location ~ \.php$ {
    include "/opt/homebrew/etc/nginx/fastcgi_params";
    fastcgi_pass 127.0.0.1:9000;
    fastcgi_index index.php;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
  }
}
